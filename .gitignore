# ------------------------------------------------------------------
# Unity generated / rebuilt automatically
# ------------------------------------------------------------------
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/
/ProfilerCaptures/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# ------------------------------------------------------------------
# IDE / build artifacts
# ------------------------------------------------------------------
.vs/
.vscode/
.idea/
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.apk
*.aab
*.unitypackage

# ------------------------------------------------------------------
# OS files
# ------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# ------------------------------------------------------------------
# Third-party / commercial Asset Store content
# Paid assets are licensed per-user and must not be published.
# Install them locally from the Asset Store to open the project.
# ------------------------------------------------------------------
/[Aa]ssets/NatureManufacture Assets/
/[Aa]ssets/AwesomeTechnologies/

# ------------------------------------------------------------------
# Local-only / scratch
# ------------------------------------------------------------------
/oplire/
/Packages_backup/
/.mcp.json
/Screenshots/

# Crash reports
sysinfo.txt
crashlytics-build.properties
